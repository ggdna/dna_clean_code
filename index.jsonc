{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "dna_clean_code",

  // 1-2 sentence summary about this repo.
  "summary": "DNA layer: language neutral code + test conventions, Dart + TypeScript specifics, review checklist; skills /code /test /review-light /review-heavy.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "code conventions: layout, API, example constructors, placeholder identifiers, naming",
    "test conventions: mirrored tree, examples, no mocks, 100% coverage",
    "AI code review checklist",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "helix": "DNA engine: instantiates dna/ into the repo (dev)",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "dna_ggdna": "layer",
      "dna_ggsuite": "layer",
      "dna_dart": "layer",
      "dna-ts": "layer",
      "ds_dna": "layer",
    },
  },
}
