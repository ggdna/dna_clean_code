{
  "name": "@ggdna/dna-clean-code",
  "version": "0.2.1",
  "description": "Gives a repo the rules for writing and testing code, language neutral and for Dart and TypeScript, and skills that check and review it.",
  "keywords": [
    "dna",
    "helix",
    "conventions",
    "scaffolding"
  ],
  "homepage": "https://github.com/ggdna/dna_clean_code",
  "bugs": "https://github.com/ggdna/dna_clean_code/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggdna/dna_clean_code.git"
  },
  "type": "module",
  "files": [
    "dna",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:dart": "dart test",
    "test": "pnpm run test:dart",
    "prepublishOnly": "pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10"
  }
}
