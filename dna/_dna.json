{
  // This package is a DNA layer: dna/ is hand-authored source and is the
  // last layer of its own instantiation.
  "version": 2,

  // Published as a DNA layer: helix requires a tag on every section of
  // dna/ markdown, so the layers above can override each one.
  "isLayer": true,

  // Orthogonal — clean code stands on its own and is inherited by the
  // umbrella layer of each organization.
  "layers": [],

  // The copyright header names the organization, so it is never
  // inherited: every layer listing this one sets dnaCopyrightHolder in
  // its own dna/_vars.json.
  "mustOverride": { "dnaCopyrightHolder": true }
}
